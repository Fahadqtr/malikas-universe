{
  "name": "malikas-universe",
  "version": "0.1.0",
  "private": true,
  "description": "Malika's Universe — e-commerce + AI customer support platform",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22.0.0 <23.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "db:types": "supabase gen types typescript --linked > packages/db/src/types.ts",
    "db:push": "supabase db push",
    "db:migrate": "supabase db push",
    "db:reset": "supabase db reset",
    "db:status": "supabase db diff --linked",
    "db:link": "supabase link --project-ref",
    "workers:dev": "pnpm --filter @malikas/workers dev",
    "web:dev": "pnpm --filter @malikas/web dev"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "turbo": "^1.13.0",
    "typescript": "^5.4.0"
  }
}
