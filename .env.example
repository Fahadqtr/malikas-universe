# ============================================================
# MALIKA'S UNIVERSE — ENVIRONMENT VARIABLES (TEMPLATE)
# ============================================================
# Copy to .env.local for local dev.
# In production: managed via Doppler (do NOT commit values).
#
# Naming convention:
#   NEXT_PUBLIC_*  → exposed to browser (Next.js convention)
#   *_KEY / *_SECRET → server-only, never expose to client
# ============================================================

# ─── ENVIRONMENT ──────────────────────────────────────────────
NODE_ENV=development
APP_ENV=local
APP_URL=http://localhost:3000

# ─── SUPABASE (Database + Auth + Storage) ─────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_PROJECT_REF=xxxxx
SUPABASE_DB_PASSWORD=your-db-password-here

# Direct Postgres connection (for migrations + workers)
DATABASE_URL=postgresql://postgres.xxxxx:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# ─── CLOUDFLARE R2 (Image storage) ────────────────────────────
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET=malikas-universe
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
NEXT_PUBLIC_CDN_URL=https://cdn.malikasuniverse.com

# ─── ANTHROPIC (Claude API) ───────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL_HAIKU=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_SONNET=claude-sonnet-4-6

# Embedding provider (Voyage AI — cheaper than OpenAI)
VOYAGE_API_KEY=your-voyage-key-here
VOYAGE_MODEL=voyage-3

# ─── WHATSAPP BUSINESS CLOUD API ──────────────────────────────
# See docs/whatsapp-live-setup.md for step-by-step setup.
WHATSAPP_TOKEN=your-permanent-access-token
WHATSAPP_PHONE_ID=your-phone-number-id
WHATSAPP_BUSINESS_ID=your-business-account-id
WHATSAPP_VERIFY_TOKEN=malikas_verify_2026
WHATSAPP_API_VERSION=v22.0
OWNER_WHATSAPP_NUMBER=+974xxxxxxxx

# Meta *App Secret* — used ONLY to verify the X-Hub-Signature-256 HMAC on
# inbound webhook POSTs. This is a DIFFERENT value from WHATSAPP_TOKEN (Graph
# API access token) and from WHATSAPP_VERIFY_TOKEN (GET-handshake string).
# Meta dashboard: App → Settings → Basic → "App Secret" → Show.
# The webhook POST route FAILS CLOSED without it (returns 503). Never commit the
# real value — set it in Doppler (prod) / .env.local (dev) only.
WHATSAPP_APP_SECRET=your-meta-app-secret

# SAFETY: when false, /api/whatsapp/webhook logs inbound messages but does NOT
# auto-reply. Flip to true ONLY after you've verified the integration on
# /whatsapp-live and tested the AI tone on /whatsapp-test.
WHATSAPP_LIVE_ENABLED=false

# ─── REDIS (BullMQ queue) ─────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_QUEUE_PREFIX=malikas

# ─── N8N (Self-hosted) ────────────────────────────────────────
N8N_URL=https://n8n.malikasuniverse.com
N8N_WEBHOOK_BASE=https://n8n.malikasuniverse.com/webhook
N8N_API_KEY=your-n8n-api-key

# ─── PLATFORM APIS ────────────────────────────────────────────
# Shopify
SHOPIFY_SHOP_DOMAIN=malikasuniverse.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_xxxxx
SHOPIFY_API_VERSION=2024-04
SHOPIFY_WEBHOOK_SECRET=your-webhook-secret

# Snoonu / Talabat / Rafeeq — CSV upload only, no API keys

# ─── MONITORING ───────────────────────────────────────────────
SENTRY_DSN=https://xxxxx@sentry.io/yyyyy
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# ─── ALERTS ───────────────────────────────────────────────────
SLACK_ALERT_WEBHOOK=https://hooks.slack.com/services/xxx/yyy/zzz

# ─── DEV ONLY (NEVER set in prod) ─────────────────────────────
# Skip auth in local dev (DO NOT enable in prod)
SKIP_AUTH=false
# Mock AI responses for testing
MOCK_AI=false
